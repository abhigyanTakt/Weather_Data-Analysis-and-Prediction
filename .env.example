# ClimaTrend Environment Variables Template
# Copy this file to .env and fill in your actual values.
# Never commit the real .env file — it's in .gitignore.

# ----------------- AI / LLM CREDENTIALS -----------------
# NVIDIA / Deepseek API Key (get yours at https://integrate.api.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_NAME=deepseek-ai/deepseek-v4.1-flash
NVIDIA_TIMEOUT=20.0

# ----------------- CLIMATE & ENVIRONMENT DATA APIS -----------------
# OpenAQ API Key (Optional: free at https://openaq.org; graceful fallback to Open-Meteo Air Quality)
OPENAQ_API_KEY=

# NASA FIRMS MAP Key (Optional: free active fire MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key)
NASA_FIRMS_MAP_KEY=

# Climatiq API Key (Optional: free tier at https://www.climatiq.io; bundled offline factors fallback)
CLIMATIQ_API_KEY=
CARTO_API_KEY=

# ----------------- UNIFIED ALERT DELIVERY LAYER (Features 6 & 7) -----------------
# Telegram Bot Delivery (Optional: create bot via @BotFather, get chat ID via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email SMTP Delivery (Optional: leave empty to skip email dispatch)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_RECIPIENT=recipient@example.com

# ntfy Push Notification Delivery (Free, open-source HTTP pub-sub topic)
NTFY_TOPIC=climatrend_emergency_alerts
NTFY_SERVER=https://ntfy.sh

# ----------------- DATABASE & SCHEDULER -----------------
# Scheduled alert check interval in hours (default: 3)
ALERT_CHECK_INTERVAL_HOURS=3
